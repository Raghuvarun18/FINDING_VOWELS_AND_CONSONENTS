name = input("enter the sentence : ")
vowels = 0
consonents = 0
spaces = 0
for i in name:
    if i in "aeious":
        vowels += 1
    elif i == " ":
        spaces += 1
    else :
        consonents += 1
print(f"vowels : {vowels}")
print(f"consonents: {consonents}")
print(f"spaces : {spaces}")
print(f"total words : {vowels+consonents}")
